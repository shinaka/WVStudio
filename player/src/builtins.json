[
  {
    "id": "claude",
    "name": "Claude usage",
    "description": "How much of your Claude plan you've used, from Claude Code's own login (sign in to Claude Code once; nothing else to set up).",
    "interval": { "default": 300, "min": 60 },
    "settings": [],
    "provides": [
      { "key": "claude.session", "label": "Session used", "unit": "%", "kind": "number" },
      { "key": "claude.session_resets", "label": "Session resets at", "kind": "time" },
      { "key": "claude.session_resets_in", "label": "Session resets in", "kind": "text" },
      { "key": "claude.session_severity", "label": "Session severity", "kind": "text" },
      { "key": "claude.week", "label": "Week used", "unit": "%", "kind": "number" },
      { "key": "claude.week_resets", "label": "Week resets at", "kind": "time" },
      { "key": "claude.week_resets_in", "label": "Week resets in", "kind": "text" },
      { "key": "claude.week_severity", "label": "Week severity", "kind": "text" },
      { "key": "claude.week.*", "label": "Week used, per model (e.g. claude.week.opus)", "unit": "%", "kind": "number", "pattern": true }
    ]
  },
  {
    "id": "pc",
    "name": "This PC",
    "description": "CPU load and memory from Windows, the GPU from NVIDIA's driver, and, with HWiNFO, Libre Hardware Monitor or PawnIO, CPU, fan, pump and motherboard sensors (HWiNFO needs Shared Memory Support on; Libre Hardware Monitor needs its Remote Web Server on; PawnIO asks for administrator rights).",
    "interval": { "default": 60, "min": 5 },
    "settings": [
      { "key": "hwinfo", "label": "Read HWiNFO sensors", "type": "bool", "default": false },
      { "key": "pawnio", "label": "Read sensors through PawnIO (asks for administrator rights)", "type": "bool", "default": false,
        "help": "CPU temperatures and power, fan and pump speeds and motherboard temperatures, read straight from the hardware through the free PawnIO driver (pawnio.eu). PawnIO needs administrator rights, so Windows asks for them when you turn this on and each time the player starts (docs/data.md, Setting up PawnIO). For live fan readings set the interval to 5 s." },
      { "key": "lhm", "label": "Read Libre Hardware Monitor sensors", "type": "bool", "default": false },
      { "key": "lhm_url", "label": "Libre Hardware Monitor address", "type": "text", "default": "http://127.0.0.1:8085" },
      { "key": "lhm_user", "label": "Libre Hardware Monitor user name", "type": "text", "default": "" },
      { "key": "lhm_password", "label": "Libre Hardware Monitor password", "type": "password" }
    ],
    "provides": [
      { "key": "pc.cpu.load", "label": "CPU load", "unit": "%", "kind": "number" },
      { "key": "pc.cpu.temp", "label": "CPU temperature (needs PawnIO, HWiNFO or Libre Hardware Monitor)", "unit": "°C", "kind": "number" },
      { "key": "pc.ram.used_gb", "label": "RAM used", "unit": "GB", "kind": "number" },
      { "key": "pc.ram.total_gb", "label": "RAM total", "unit": "GB", "kind": "number" },
      { "key": "pc.ram.used_pct", "label": "RAM used", "unit": "%", "kind": "number" },
      { "key": "pc.gpu.temp", "label": "GPU temperature", "unit": "°C", "kind": "number" },
      { "key": "pc.gpu.load", "label": "GPU load", "unit": "%", "kind": "number" },
      { "key": "pc.gpu.power", "label": "GPU power", "unit": "W", "kind": "number" },
      { "key": "pc.gpu.vram_used_gb", "label": "VRAM used", "unit": "GB", "kind": "number" },
      { "key": "pc.gpu.vram_total_gb", "label": "VRAM total", "unit": "GB", "kind": "number" },
      { "key": "hwinfo.*", "label": "HWiNFO readings, as hwinfo.<sensor>.<label>", "kind": "number", "pattern": true },
      { "key": "lhm.*", "label": "Libre Hardware Monitor sensors, as lhm.<hardware>.<type>.<sensor>", "kind": "number", "pattern": true },
      { "key": "pawnio.*", "label": "PawnIO sensors, as pawnio.cpu.<type>.<sensor> and pawnio.<chip>.<type>.<sensor>", "kind": "number", "pattern": true }
    ]
  },
  {
    "id": "homeassistant",
    "name": "Home Assistant",
    "description": "The state, unit and attributes of the Home Assistant entities you list, read with a long-lived access token (Profile > Security in Home Assistant).",
    "interval": { "default": 60, "min": 5 },
    "settings": [
      { "key": "url", "label": "URL", "type": "text", "default": "http://homeassistant.local:8123" },
      { "key": "token", "label": "Long-lived access token", "type": "password" },
      { "key": "entities", "label": "Entities (one per line)", "type": "list", "default": [] }
    ],
    "provides": [
      { "key": "ha.*", "label": "Entity states: ha.<entity_id>, with ha.<entity_id>.unit and one key per attribute", "pattern": true }
    ]
  },
  {
    "id": "time",
    "name": "Time",
    "description": "The current local time. Always on.",
    "interval": { "default": 60, "min": 1 },
    "settings": [],
    "provides": [
      { "key": "time", "label": "Time now", "kind": "time" }
    ]
  }
]
